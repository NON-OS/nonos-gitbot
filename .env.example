# Telegram
BOT_TOKEN=123456789:AA...          # from @BotFather (or use BOT_TOKEN_FILE / systemd credential)
CHAT_ID=-1001234567890             # the group id the bot posts to
MESSAGE_THREAD_ID=                 # optional: a topic id, to post into one "Git" topic

# Forgejo webhook
WEBHOOK_SECRET=change-me           # the org webhook secret (or WEBHOOK_SECRET_FILE / systemd credential)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3191
WEBHOOK_PATH=/forgejo

# Forge
FORGE_BASE=https://git.nonos.software
ORG=NON-OS

# Behaviour
MAX_COMMITS=5
SUMMARY_CHARS=90
SKIP_DRAFTS=1
LOG_LEVEL=INFO

# Batch commit posts per repo and branch for this many seconds (0 = immediate).
BATCH_SECONDS=60
# Private chat id for failure alerts (0 = off). Not the group.
ADMIN_CHAT_ID=
